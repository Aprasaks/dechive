# Local development defaults to Docker when these are unset.
DATABASE_URL=
DATABASE_DIRECT_URL=

# Optional public app URL used for same-origin Knowledge link normalization.
# Vercel's automatic project URL variables and the browser origin are used when unset.
NEXT_PUBLIC_SITE_URL=

# Single-owner admin authentication. Generate a bcrypt hash and a random session secret.
# Never expose these through NEXT_PUBLIC_ variables.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Operator-only staging commands. Never expose these with NEXT_PUBLIC_.
STAGING_DATABASE_URL=
STAGING_DATABASE_DIRECT_URL=

# Media storage. Local is the default for development; production must use r2.
MEDIA_STORAGE_PROVIDER=local

# Docker/local persistent media volume.
# Host `npm run dev` consumes the same bind-mounted directory used by Docker.
# If the Next.js app runs in a container, use /data/media instead.
MEDIA_LOCAL_ROOT=./.data/media
MEDIA_LOCAL_PUBLIC_PATH=/api/media

# Cloudflare R2. Required when MEDIA_STORAGE_PROVIDER=r2; never commit values.
MEDIA_R2_ENDPOINT=
MEDIA_R2_BUCKET=
MEDIA_R2_ACCESS_KEY_ID=
MEDIA_R2_SECRET_ACCESS_KEY=
MEDIA_R2_REGION=auto
MEDIA_PUBLIC_BASE_URL=https://media.dechive.dev

# Optional analytics adapters. Dechive's own Postgres events remain the source of truth.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
SEARCH_CONSOLE_SITE_URL=https://dechive.dev
# Optional dedicated credentials. If unset, the existing GA service-account credentials are reused.
SEARCH_CONSOLE_CLIENT_EMAIL=
SEARCH_CONSOLE_PRIVATE_KEY=
# Server-only token used only when a Cloudflare reporting adapter is added.
CLOUDFLARE_ANALYTICS_TOKEN=

# Manual analytics retention job. It refuses to run without explicit confirmation.
ANALYTICS_RETENTION_DAYS=365
ANALYTICS_PRUNE_CONFIRM=
