# Public Supabase values from the project's Connect panel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical public origin used for metadata, feeds, and absolute links.
NEXT_PUBLIC_SITE_URL=https://dechive.dev

# Server-only credentials. Never expose these through NEXT_PUBLIC_ variables.
# Add only when a server-side workflow actually requires elevated access.
SUPABASE_SERVICE_ROLE_KEY=

# Jarvis calls Dechive's server API with a scoped integration token.
# Store only a SHA-256 hash of the issued token in Postgres.
JARVIS_SYNC_TOKEN=
